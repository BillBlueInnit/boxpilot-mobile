.DS_Store
.idea/
*.iml
.kotlin/

# Gradle output of the local module
/modules/*/android/build/
/modules/*/android/.cxx/

# Rust bridge build output
/rust/target/
/modules/boxpilot-core/android/src/main/jniLibs/
/modules/boxpilot-core/ios/BoxpilotBridge.xcframework/

# Built from sing-box by scripts/build_libbox.sh
/build/
/modules/boxpilot-core/android/libs/libbox.aar
/native/ios/Libbox.xcframework/

